generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum SeoEntityType {
  COUNTRY
  CATEGORY
  SERVICE
  ARTICLE
  SITE_PAGE
  CONSULATE
}

enum SectionType {
  GENERAL
  REQUIREMENTS
  DOCUMENTS
  PROCESS
  FEES
  FAQ
  CUSTOM
}

enum FeeType {
  CONSULAR
  SERVICE
  APPLICATION_CENTER
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Country {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  iso2             String?  @unique @db.Char(2)
  iso3             String?  @db.Char(3)
  flag             String?
  shortDescription String?  @map("short_description") @db.Text
  description      String?  @db.Text
  heroImage        String?  @map("hero_image")
  visaRegion              String?  @map("visa_region")
  requiresAppointment     Boolean  @default(false) @map("requires_appointment")
  averageProcessingTime   String?  @map("average_processing_time")
  detailParagraph1        String?  @map("detail_paragraph_1") @db.Text
  detailParagraph2        String?  @map("detail_paragraph_2") @db.Text
  importantNotesJson      String?  @map("important_notes_json") @db.Text
  detailSectionsJson      String?  @map("detail_sections_json") @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  services             Service[]
  faqs                 Faq[]
  articles             Article[]
  consulates           Consulate[]
  feesAsNationality    Fee[]      @relation("FeeNationality")
  siteAssets           SiteAsset[]

  @@index([isActive, sortOrder])
  @@map("countries")
}

model Category {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?  @map("short_description") @db.Text
  description      String?  @db.Text
  categoryType     String?  @map("category_type")
  icon             String?
  image            String?
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  services Service[]
  faqs     Faq[]
  articleLinks ArticleCategoryLink[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Service {
  id                  String   @id @default(cuid())
  countryId           String   @map("country_id")
  categoryId          String   @map("category_id")
  name                String
  slug                String
  shortTitle          String?  @map("short_title")
  shortDescription    String?  @map("short_description") @db.Text
  description         String?  @db.Text
  heroImage           String?  @map("hero_image")
  heroTitle           String?  @map("hero_title")
  heroSubtitle        String?  @map("hero_subtitle") @db.Text
  sectionsJson        String?  @map("sections_json") @db.Text
  featureImage1       String?  @map("feature_image_1")
  featureImage1Title  String?  @map("feature_image_1_title")
  featureImage1Text   String?  @map("feature_image_1_text") @db.Text
  featureImage2       String?  @map("feature_image_2")
  featureImage2Title  String?  @map("feature_image_2_title")
  featureImage2Text   String?  @map("feature_image_2_text") @db.Text
  icon                String?
  isFeatured          Boolean  @default(false) @map("is_featured")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  processingTime      String?  @map("processing_time")
  requiresAppointment Boolean  @default(false) @map("requires_appointment")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  country          Country           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections         ServiceSection[]
  serviceDocuments ServiceDocument[]
  fees             Fee[]
  faqs             Faq[]

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([categoryId])
  @@index([countryId, isActive, isFeatured])
  @@map("services")
}

model ServiceSection {
  id          String      @id @default(cuid())
  serviceId   String      @map("service_id")
  title       String
  slug        String
  sectionType SectionType @default(CUSTOM) @map("section_type")
  content     String      @db.Text
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, slug])
  @@index([serviceId, sortOrder])
  @@map("service_sections")
}

model Document {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String? @db.Text
  documentType String? @map("document_type")
  isActive     Boolean @default(true) @map("is_active")

  serviceDocuments ServiceDocument[]

  @@map("documents")
}

model ApplicantProfile {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true) @map("is_active")

  serviceDocuments ServiceDocument[]

  @@map("applicant_profiles")
}

model ServiceDocument {
  id                 String  @id @default(cuid())
  serviceId          String  @map("service_id")
  documentId         String  @map("document_id")
  applicantProfileId String? @map("applicant_profile_id")
  isRequired         Boolean @default(true) @map("is_required")
  descriptionOverride String? @map("description_override") @db.Text
  sortOrder          Int     @default(0) @map("sort_order")

  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  applicantProfile ApplicantProfile? @relation(fields: [applicantProfileId], references: [id], onDelete: SetNull)

  @@unique([serviceId, documentId, applicantProfileId])
  @@index([serviceId])
  @@map("service_documents")
}

model Fee {
  id                   String    @id @default(cuid())
  serviceId            String    @map("service_id")
  name                 String
  feeType              FeeType   @map("fee_type")
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("EUR") @db.VarChar(3)
  ageMin               Int?      @map("age_min")
  ageMax               Int?      @map("age_max")
  nationalityCountryId String?   @map("nationality_country_id")
  validFrom            DateTime? @map("valid_from")
  validUntil           DateTime? @map("valid_until")
  description          String?   @db.Text
  isActive             Boolean   @default(true) @map("is_active")

  service            Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  nationalityCountry Country? @relation("FeeNationality", fields: [nationalityCountryId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@map("fees")
}

model Faq {
  id         String  @id @default(cuid())
  countryId  String? @map("country_id")
  categoryId String? @map("category_id")
  serviceId  String? @map("service_id")
  question   String
  answer     String  @db.Text
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")

  country  Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([countryId])
  @@index([categoryId])
  @@index([serviceId])
  @@map("faqs")
}

model ArticleCategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  articles Article[]

  @@map("article_categories")
}

model Article {
  id                String    @id @default(cuid())
  countryId         String    @map("country_id")
  articleCategoryId String?   @map("article_category_id")
  title             String
  slug              String    @unique
  excerpt           String?   @db.Text
  content           String    @default("") @db.Text
  heroTitle         String?   @map("hero_title")
  heroSubtitle      String?   @map("hero_subtitle") @db.Text
  heroImage         String?   @map("hero_image")
  sectionsJson      String?   @map("sections_json") @db.Text
  featureImage      String?   @map("feature_image")
  featureImageTitle String?   @map("feature_image_title")
  featureImageText  String?   @map("feature_image_text") @db.Text
  coverImage        String?   @map("cover_image")
  publishedAt       DateTime? @map("published_at")
  isPublished       Boolean   @default(false) @map("is_published")
  showInCategoryPanel Boolean @default(false) @map("show_in_category_panel")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  country         Country          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  articleCategory ArticleCategory? @relation(fields: [articleCategoryId], references: [id], onDelete: SetNull)
  linkedCategories ArticleCategoryLink[]

  @@index([isPublished, publishedAt])
  @@index([countryId])
  @@index([countryId, isPublished])
  @@map("articles")
}

model Consulate {
  id           String   @id @default(cuid())
  countryId    String   @map("country_id")
  name         String
  slug         String
  heroTitle    String?  @map("hero_title")
  heroImage    String?  @map("hero_image")
  sectionsJson String?  @map("sections_json") @db.Text
  mapEmbedUrl  String?  @map("map_embed_url") @db.Text
  mapAddress   String?  @map("map_address") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([countryId, slug])
  @@index([countryId, isActive, sortOrder])
  @@map("consulates")
}

model ArticleCategoryLink {
  id         String   @id @default(cuid())
  articleId  String   @map("article_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([articleId, categoryId])
  @@index([categoryId])
  @@map("article_category_links")
}

model SeoMetadata {
  id              String        @id @default(cuid())
  entityType      SeoEntityType @map("entity_type")
  entityId        String        @map("entity_id")
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description") @db.Text
  canonicalUrl    String?       @map("canonical_url")
  ogTitle         String?       @map("og_title")
  ogDescription   String?       @map("og_description") @db.Text
  ogImage         String?       @map("og_image")
  robotsIndex     Boolean       @default(true) @map("robots_index")
  robotsFollow    Boolean       @default(true) @map("robots_follow")
  structuredData  String?       @map("structured_data") @db.Text

  @@unique([entityType, entityId])
  @@map("seo_metadata")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model SitePage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_pages")
}

/** Form, dilekçe ve indirilebilir dökümanlar (/asset/{id}/{ülke}/{dosya}) */
model SiteAsset {
  id                 Int      @id @default(autoincrement())
  countryId          String   @map("country_id")
  fileName           String   @map("file_name")
  cloudinaryPublicId String?  @map("cloudinary_public_id")
  fileUrl            String   @map("file_url")
  fileData           Bytes?   @map("file_data")
  mimeType           String?  @map("mime_type")
  byteSize           Int?     @map("byte_size")
  showInMenu         Boolean  @default(false) @map("show_in_menu")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([countryId, fileName])
  @@index([countryId])
  @@map("site_assets")
}
